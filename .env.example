# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker compose defaults)
CEM_DATABASE_URL=postgresql://cem:cem_local_dev@localhost:5432/cem

# Identify yourself to the site operator (added to the User-Agent).
CEM_CONTACT_EMAIL=

# Throughput: keep conservative. Hard caps: concurrency <= 16, rps <= 5.
# Measured fast but stable setting: 1.5 rps, CEM_CONCURRENCY=10, CEM_MAX_CONCURRENCY=14 (see README).
# The request rate never exceeds CEM_REQUESTS_PER_SECOND. Adaptive concurrency only
# decides how many requests may wait for a (slow) response at once, within
# [1, CEM_MAX_CONCURRENCY], starting at CEM_CONCURRENCY.
CEM_REQUESTS_PER_SECOND=0.5
CEM_CONCURRENCY=2
CEM_MAX_CONCURRENCY=4
CEM_ADAPTIVE_CONCURRENCY=true
CEM_LATENCY_TOLERANCE=1.5
# Exam sessions open at once: the next one is authorized while the current one is
# collected (CAPTCHAs still one at a time). 1 = strictly sequential.
CEM_PIPELINE_DEPTH=2
# Proxy lanes (only with the site operator's permission; needs CEM_ACCESS_PROVIDER=http_form).
# Each proxy = its own CEM session, CAPTCHA and rate limit; rates add up across lanes.
# 2Captcha residential proxies: in the generator set IP duration 15-30 min (0 = new IP per request breaks the cookie).
# CEM_PROXY_URLS=http://LOGIN:PASSWORD@HOST:PORT,http://LOGIN2:PASSWORD2@HOST:PORT
CEM_PROXY_INCLUDE_DIRECT=true
# Paid proxy traffic one proxy lane may use per run (approx.; one session is ~3-3.5 MB).
# A broken or exhausted proxy lane is retired and its sessions continue on the other lanes.
CEM_PROXY_MAX_MB=150
CEM_CONNECT_TIMEOUT=10
CEM_READ_TIMEOUT=45
CEM_MAX_RETRIES=4
CEM_BACKOFF_BASE=2
CEM_BACKOFF_MAX=60
CEM_MAX_RETRY_AFTER=300
CEM_CIRCUIT_BREAKER_THRESHOLD=5
# On a timeout/429/5xx, pause the whole lane (IP); stop when a lane gets no answer for this long.
CEM_OVERLOAD_PAUSE=30
CEM_STALL_TIMEOUT=180

# Targets (default: 20031..20132 plus 20262) and discovery
# CEM_TARGET_SESSIONS=20031,20262
CEM_SPECIALIZATION_CODE=725
CEM_MAX_QUESTION_NUMBER=250
CEM_MISSING_STREAK_TO_STOP=3

# Access: manual_chrome (you solve the reCAPTCHA in your own, uncontrolled Chrome; recommended)
# | interactive_browser (same in a Playwright window; reCAPTCHA sees automation, many rounds)
# | http_form (fully automated, needs a CAPTCHA provider + CEM_ACCEPT_EULA=true) | fixtures (offline)
CEM_ACCESS_PROVIDER=manual_chrome
# Separate, persistent browser profile (keeps Google's trust between runs; git-ignored)
CEM_BROWSER_PROFILE_DIR=browser_profile
# manual_chrome: Chrome binary (auto-detected when empty) and its local DevTools port
CEM_CHROME_PATH=
CEM_CHROME_DEBUG_PORT=9222
# disabled | 2captcha (paid; check with `cem-scraper captcha-balance`)
CEM_CAPTCHA_PROVIDER=disabled
CEM_TWOCAPTCHA_API_KEY=
# Per-run caps (2Captcha account currency, USD). One reCAPTCHA v2 costs ~0.001-0.003.
CEM_CAPTCHA_MAX_SPEND=1.0
CEM_CAPTCHA_MAX_SOLVES=40
# Lifetime cap over all runs recorded in the database (USD; at most 25, about 100 PLN)
CEM_CAPTCHA_TOTAL_BUDGET=5.0
CEM_CAPTCHA_TIMEOUT=180
CEM_CAPTCHA_POLL_INTERVAL=5
# Set to true only after reading https://www.cem.edu.pl/pytcem/eula_pes.php
CEM_ACCEPT_EULA=false
CEM_BROWSER_WAIT_TIMEOUT=600
CEM_BROWSER_CONTEXT_REQUESTS=false
CEM_MAX_REAUTHORIZATIONS_PER_SESSION=1

# Output and diagnostics
CEM_OUTPUT_DIR=output
# CEM_SAVE_HTML_DIR=html_snapshots
CEM_LOG_LEVEL=INFO
CEM_LOG_JSON=false
